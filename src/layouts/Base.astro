---
// brand.css must load first: it defines the tokens main.css consumes.
// It is vendored from redfearn-group/redfearn-brand and CI fails on drift.
import "../styles/brand.css";
import "../styles/main.css";

interface Props {
  title: string;
}
const { title } = Astro.props;

const withBase = (p: string) => `${import.meta.env.BASE_URL}${p}`.replace(/\/+/g, "/");
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isDashboard = currentPath === (withBase("/").replace(/\/$/, "") || "/");
const isMeetings = currentPath.startsWith(withBase("/meetings").replace(/\/$/, ""));
const isContracts = currentPath.startsWith(withBase("/contracts").replace(/\/$/, ""));
const isExpenses = currentPath.startsWith(withBase("/expenses").replace(/\/$/, ""));
const isBudget = currentPath.startsWith(withBase("/budget").replace(/\/$/, ""));
const isGovernance = currentPath.startsWith(withBase("/governance").replace(/\/$/, ""));
---
<html lang="en" class="app-layer">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Canyon Breeze Manor HOA</title>
    <link rel="icon" href={withBase("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;1,300&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;1,300&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header no-print">
      <div class="container">
        <a class="site-brand" href={withBase("/")}>
          <img src={withBase("/logo-wide-dark.svg")} alt="Redfearn Group" width="305" height="50" />
          <span class="site-brand__app">Canyon Breeze Manor HOA</span>
        </a>
        <nav class="site-nav">
          <a href={withBase("/")} aria-current={isDashboard ? "page" : undefined}>Dashboard</a>
          <a href={withBase("/meetings")} aria-current={isMeetings ? "page" : undefined}>Meetings</a>
          <a href={withBase("/contracts")} aria-current={isContracts ? "page" : undefined}>Contracts</a>
          <a href={withBase("/expenses")} aria-current={isExpenses ? "page" : undefined}>Expenses</a>
          <a href={withBase("/budget")} aria-current={isBudget ? "page" : undefined}>Budget</a>
          <a href={withBase("/governance")} aria-current={isGovernance ? "page" : undefined}>Governance</a>
        </nav>
      </div>
    </header>
    <main class="container" id="main">
      <slot />
    </main>
    <footer class="site-footer no-print">
      <div class="container">
        <a href="https://redfearn.group" class="site-footer__brand" target="_blank" rel="noopener">
          <img src={withBase("/logo-lockup-dark.svg")} alt="Redfearn Group" width="250" height="58" />
        </a>
        <p class="site-footer__meta">
          Built by <a href="https://redfearn.group" target="_blank" rel="noopener">Redfearn Group</a>. Financial figures, vendor terms, and meeting minutes are kept in a private, not-publicly-committed file.
        </p>
        <div class="site-footer__bottom">
          <span>REDFEARN GROUP &middot; EST. 2014 &middot; SPANISH FORK, UT</span>
          <span>&copy; {new Date().getFullYear()} Brady Redfearn</span>
        </div>
      </div>
    </footer>
  </body>
</html>
