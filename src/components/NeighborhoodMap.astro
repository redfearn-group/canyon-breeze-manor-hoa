---
// Inlines the base map SVG at build time and draws data on top of it.
//
// Zone SHAPES come from the SVG (exported from Figma, each carrying
// id="zone-<id>"). Pins come from YAML, positioned in the SVG's viewBox
// space. These are not geographic coordinates and must not become them.
//
// Layer visibility is CSS-driven off classes on a wrapper element. With
// JavaScript disabled every layer renders, which is the point: the map is
// progressive enhancement over the tables below it, not a replacement.
import fs from "node:fs";
import path from "node:path";
import type { Controller, Zone, IrrigationAsset, Tree, Issue } from "../lib/types";
import { zoneStatusClass } from "../lib/status-tag";

interface Props {
  zones: Zone[];
  controllers: Controller[];
  assets?: IrrigationAsset[];
  trees?: Tree[];
  openIssuesByZone?: Map<string, Issue[]>;
  caption: string;
}

const {
  zones,
  controllers,
  assets = [],
  trees = [],
  openIssuesByZone = new Map<string, Issue[]>(),
  caption,
} = Astro.props;

// Deliberately under src/, not public/. The artwork is inlined at build
// time, so serving it as a standalone asset adds nothing and would publish
// the file's authoring comments at a fetchable URL.
const BASE_MAP = path.resolve(process.cwd(), "src/map/base.svg");
let baseSvg = fs.existsSync(BASE_MAP) ? fs.readFileSync(BASE_MAP, "utf-8") : "";

// Strip the XML prolog and the outer <svg> wrapper: we re-open our own so
// we control the viewBox, role, and aria-label, and so the pin layers sit
// inside the same coordinate space as the artwork.
const viewBoxMatch = baseSvg.match(/viewBox="([^"]+)"/);
const viewBox = viewBoxMatch ? viewBoxMatch[1] : "0 0 1000 700";
baseSvg = baseSvg
  .replace(/<\?xml[\s\S]*?\?>/g, "")
  // Comments too. Authoring notes in the source SVG (which Figma file it
  // came from, what must never be exported into it) would otherwise ship
  // verbatim into page source, publishing the guardrail to the people it
  // guards against.
  .replace(/<!--[\s\S]*?-->/g, "")
  .replace(/<svg[^>]*>/, "")
  .replace(/<\/svg>\s*$/, "");

// The zone loop below splices values into a raw markup string that is
// handed to `set:html`, so Astro's own escaping never sees them. Two
// separate hazards, two separate escapes:
//
//   - Attribute values. A double quote in a label or an area ("the 24"
//     main") would close the attribute early and the rest of the label
//     would parse as markup. `<`, `>`, and `&` are escaped for the same
//     reason.
//   - The id inside the RegExp. A zone id carrying `.`, `+`, `(` or any
//     other metacharacter would be compiled as a pattern rather than
//     matched literally, so the shape either silently matches the wrong
//     element or never matches at all.
const escapeAttr = (value: unknown): string =>
  String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");

const escapeRegExp = (value: unknown): string =>
  String(value ?? "").replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

// Apply a status class to each zone group the export gave us an id for.
// A zone in the YAML with no matching shape simply has no shape: it still
// appears in the table below, which is why the table is not optional.
//
// No `tabindex` and no `role="listitem"` here. The SVG is `role="img"`,
// which makes everything inside it presentational, so a focus stop on a
// shape was a tab stop with no announceable name and the listitem role
// had no list to belong to. The `aria-label` stays as the authored name
// of the shape and is escaped for the reason above; non-visual access to
// the same facts comes from the tables on the page.
let drawnZoneCount = 0;
for (const zone of zones) {
  const worst = openIssuesByZone.get(zone.id)?.[0]?.severity;
  const cls = zoneStatusClass(zone.condition, worst);
  const before = baseSvg;
  const attrs = ` class="zone ${cls}" aria-label="${escapeAttr(zone.label)}, ${escapeAttr(zone.area)}"`;
  baseSvg = baseSvg.replace(
    new RegExp(`(<(?:g|path)\\b[^>]*\\bid="zone-${escapeRegExp(zone.id)}")`),
    // Replacer function, not a template string: in a string replacement a
    // `$&` or `$1` inside a zone label would be read as a backreference.
    (match) => match + attrs
  );
  if (baseSvg !== before) drawnZoneCount += 1;
}

const placedControllers = controllers.filter((c) => c.x != null && c.y != null);
const placedAssets = assets.filter((a) => a.x != null && a.y != null);
const placedTrees = trees.filter((t) => t.x != null && t.y != null);

const hasBaseMap = !baseSvg.includes("Neighborhood map not loaded yet");

// The label describes what this SVG actually draws, counted rather than
// asserted, so it stays true in the empty state and once the data lands.
// Zones are counted by shapes matched above, not by rows in the YAML: a
// zone the base map has no shape for is on the page only as a table row.
const count = (n: number, one: string, many: string): string =>
  `${n} ${n === 1 ? one : many}`;

const drawn = [
  count(drawnZoneCount, "watering zone shape", "watering zone shapes"),
  count(placedControllers.length, "controller pin", "controller pins"),
  count(placedAssets.length, "valve and backflow pin", "valve and backflow pins"),
  count(placedTrees.length, "tree pin", "tree pins"),
].join(", ");

// Both variants point at the four tables on the page: zones, controllers,
// valves and backflow, and trees. Keep that promise and the tables in
// step with each other.
const tablesNote =
  "Every watering zone, controller, valve and backflow device, and tree is listed in full in the tables below this map.";

const ariaLabel = hasBaseMap
  ? `Map of Canyon Breeze Manor common areas, drawing ${drawn}. ${tablesNote}`
  : `Placeholder for the neighborhood map. The base map artwork has not been loaded yet, so the diagram draws ${drawn}. ${tablesNote}`;
---

<figure class="map-figure">
  {!hasBaseMap && (
    <p class="notice map-notice">
      The base map artwork has not been loaded yet, so the diagram below is a
      placeholder. Everything recorded so far is in the tables on this page.
    </p>
  )}

  <div class="map-controls no-print" hidden>
    <fieldset>
      <legend>Map layers</legend>
      <label><input type="checkbox" data-layer="zones" checked /> Watering zones</label>
      <label><input type="checkbox" data-layer="controllers" checked /> Controllers</label>
      <label><input type="checkbox" data-layer="assets" checked /> Valves and backflow</label>
      <label><input type="checkbox" data-layer="trees" checked /> Trees</label>
    </fieldset>
  </div>

  <div class="map-wrap" id="map-wrap">
    <svg
      viewBox={viewBox}
      class="neighborhood-map"
      role="img"
      aria-label={ariaLabel}
      preserveAspectRatio="xMidYMid meet"
    >
      <g class="layer layer--base" set:html={baseSvg} />

      {placedControllers.length > 0 && (
        <g class="layer layer--controllers">
          {placedControllers.map((c) => (
            <g class="pin pin--controller" transform={`translate(${c.x} ${c.y})`}>
              <rect x="-11" y="-11" width="22" height="22" rx="4" />
              <text y="5" text-anchor="middle">{c.label.replace(/[^0-9]/g, "") || "C"}</text>
              <title>{`${c.label}: ${c.areaServed}`}</title>
            </g>
          ))}
        </g>
      )}

      {placedAssets.length > 0 && (
        <g class="layer layer--assets">
          {placedAssets.map((a) => (
            <g class="pin pin--asset" transform={`translate(${a.x} ${a.y})`}>
              <path d="M0,-9 L9,0 L0,9 L-9,0 Z" />
              <title>{`${a.label} (${a.type.replace(/-/g, " ")})`}</title>
            </g>
          ))}
        </g>
      )}

      {placedTrees.length > 0 && (
        <g class="layer layer--trees">
          {placedTrees.map((t) => (
            <circle
              class={`pin pin--tree tree--${t.health}`}
              cx={t.x}
              cy={t.y}
              r="6"
            >
              <title>{`${t.commonName}: ${t.health.replace(/-/g, " ")}`}</title>
            </circle>
          ))}
        </g>
      )}
    </svg>
  </div>

  <figcaption>{caption}</figcaption>
</figure>

<script>
  // Progressive enhancement only. The controls start hidden and are
  // revealed here, so a no-JS reader never sees toggles that do nothing.
  const controls = document.querySelector<HTMLElement>(".map-controls");
  const wrap = document.getElementById("map-wrap");
  if (controls && wrap) {
    controls.hidden = false;
    controls.addEventListener("change", (event) => {
      const input = event.target as HTMLInputElement;
      if (!input.dataset.layer) return;
      wrap.classList.toggle(`hide-${input.dataset.layer}`, !input.checked);
    });
  }
</script>
