---
// The landscaping map. This page is the reason the site exists: it turns
// "the sprinkler by the mailboxes" into a zone number a contractor can act
// on. The tables below the map are not decoration. They are the accessible
// and printable version of the same data, and they are the only view that
// works when a zone has no shape in the base map yet.
//
// One table per map layer, in the order the layer toggles list them:
// zones, controllers, valves and backflow, trees. The map's aria-label
// promises exactly that, so a layer added to the map needs a table here
// and a fourth column of nothing is better than a missing table.
import Base from "../../layouts/Base.astro";
import NeighborhoodMap from "../../components/NeighborhoodMap.astro";
import {
  getZones,
  getControllers,
  getIrrigationAssets,
  getTrees,
  getOpenIssuesByZone,
  getIssues,
} from "../../lib/data";
import { withBase } from "../../lib/kit/base";
import { statusTagClass } from "../../lib/status-tag";

const zones = getZones();
const controllers = getControllers();
const assets = getIrrigationAssets();
const trees = getTrees();
const openIssuesByZone = getOpenIssuesByZone();
// Counted the same way as the home page and the issues page: every issue
// that is not resolved, INCLUDING any that names no zone yet. Summing
// openIssuesByZone instead would silently drop those, so the same label
// would report a smaller number here than on the other two pages. The
// map still colours by zone, which is a different question.
const openIssueCountAll = getIssues().filter((i) => i.status !== "resolved").length;



const controllerLabel = (id?: string): string =>
  (id && controllers.find((c) => c.id === id)?.label) || "—";

const zoneLabel = (id?: string): string =>
  (id && zones.find((z) => z.id === id)?.label) || "—";

// Title-cases as well as de-hyphenating, matching watering.astro and the
// zone detail page. Without it the map page rendered "needs repair" in a
// status tag while its siblings rendered "Needs repair".
const humanize = (value: string): string => {
  const spaced = value.replace(/-/g, " ");
  return spaced.charAt(0).toUpperCase() + spaced.slice(1);
};

// One sentence, and it has to hold true before the zone data lands.
const caption =
  zones.length > 0
    ? "Each shape is one watering zone, colored by its condition, and the number on it is what to quote when you report a problem."
    : "The map will show one shape per watering zone once the zone layout is recorded, and each shape will carry the number to quote when reporting a problem.";
---
<Base title="Landscaping map">
  <nav class="subnav" aria-label="Landscaping sections">
    <a href={withBase("/landscaping")} aria-current="page">Map</a>
    <a href={withBase("/landscaping/watering")}>Watering times</a>
    <a href={withBase("/landscaping/trees")}>Trees</a>
    <a href={withBase("/landscaping/issues")}>Issues</a>
    <a href={withBase("/landscaping/water")}>Water use</a>
    <a href={withBase("/landscaping/report")}>Report a problem</a>
  </nav>

  <div class="eyebrow">Landscaping</div>
  <h2>Common-area irrigation map</h2>
  <p>
    Every sprinkler in the common areas belongs to a numbered watering zone,
    and every zone belongs to one of the controllers. Find the zone here,
    then use its number when you report a dry patch, a broken head, or water
    running at the wrong time.
  </p>

  {zones.length === 0 && (
    <p class="notice">
      Zone numbers are not published yet. The zone layout is being traced
      from the property irrigation map, so for now the only confirmed fact
      is that the system runs on {controllers.length} controllers. When the
      layout lands, each zone here gets a number, the area it covers, its
      head type, what is planted in it, and a color for its condition.
      Nothing on this page is invented ahead of that: a wrong zone number
      sends a contractor to the wrong corner of the property.
    </p>
  )}

  <div class="stat-row">
    <div>
      <span class="stat-value">{zones.length}</span>
      <span class="stat-label">Zones</span>
    </div>
    <div>
      <span class="stat-value">{controllers.length}</span>
      <span class="stat-label">Controllers</span>
    </div>
    <div>
      <span class="stat-value">{openIssueCountAll}</span>
      <span class="stat-label">Open issues</span>
    </div>
    <div>
      <span class="stat-value">{trees.length}</span>
      <span class="stat-label">Trees tracked</span>
    </div>
  </div>

  <NeighborhoodMap
    zones={zones}
    controllers={controllers}
    assets={assets}
    trees={trees}
    openIssuesByZone={openIssuesByZone}
    caption={caption}
  />

  <ul class="map-legend">
    <li>
      <span
        class="swatch"
        style="background: var(--status-ok-bg); color: var(--status-ok-fg);"
        aria-hidden="true"
      ></span>
      Working
    </li>
    <li>
      <span
        class="swatch"
        style="background: var(--status-due-soon-bg); color: var(--status-due-soon-fg);"
        aria-hidden="true"
      ></span>
      Needs attention
    </li>
    <li>
      <span
        class="swatch"
        style="background: var(--status-overdue-bg); color: var(--status-overdue-fg);"
        aria-hidden="true"
      ></span>
      Open problem
    </li>
    <li>
      <span
        class="swatch"
        style="background: var(--status-never-bg); color: var(--status-never-fg);"
        aria-hidden="true"
      ></span>
      Not yet assessed
    </li>
  </ul>

  <h3>Every zone</h3>
  <p>
    The same information as the map, in a form that reads aloud, prints, and
    still works for a zone the map has no shape for yet.
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Zone</th>
          <th>Controller</th>
          <th>Area</th>
          <th>Head type</th>
          <th>Planting</th>
          <th>Condition</th>
          <th>Open issues</th>
        </tr>
      </thead>
      <tbody>
        {zones.length === 0 && (
          <tr>
            <td colspan="7">No zones recorded yet.</td>
          </tr>
        )}
        {zones.map((zone) => {
          const open = openIssuesByZone.get(zone.id) ?? [];
          return (
            <tr>
              <td>
                <a href={withBase(`/landscaping/zones/${zone.id}`)}>{zone.label}</a>
              </td>
              <td>{controllerLabel(zone.controllerId)}</td>
              <td>{zone.area}</td>
              <td>{humanize(zone.headType)}</td>
              <td>{humanize(zone.plantType)}</td>
              <td>
                <span class={`tag ${statusTagClass(zone.condition)}`}>
                  {humanize(zone.condition)}
                </span>
              </td>
              <td>
                {open.length === 0 ? (
                  "—"
                ) : (
                  <span class={`tag ${statusTagClass(open[0].severity)}`}>
                    {open.length} open, worst {open[0].severity}
                  </span>
                )}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <h3>Every controller</h3>
  <p>
    The controller layer of the map, listed. Each controller runs a set of
    zones, and the programmed watering times for those zones are on the
    {" "}<a href={withBase("/landscaping/watering")}>watering times</a> page.
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Controller</th>
          <th>Area served</th>
          <th>Zones</th>
          <th>Condition</th>
        </tr>
      </thead>
      <tbody>
        {controllers.length === 0 && (
          <tr>
            <td colspan="4">No controllers recorded yet.</td>
          </tr>
        )}
        {controllers.map((controller) => (
          <tr>
            <td>{controller.label}</td>
            <td>{controller.areaServed}</td>
            <td>{controller.zoneCount > 0 ? controller.zoneCount : "—"}</td>
            <td>
              <span class={`tag ${statusTagClass(controller.condition)}`}>
                {humanize(controller.condition)}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3>Valves and backflow</h3>
  <p>
    The fixed equipment layer: backflow preventers, master valves, mainline
    shutoffs, and valve boxes. What each one is and whether it works is
    published here. Where it physically sits is not, because a public list
    of every shutoff on the property helps no resident.
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Device</th>
          <th>Type</th>
          <th>Controller</th>
          <th>Condition</th>
        </tr>
      </thead>
      <tbody>
        {assets.length === 0 && (
          <tr>
            <td colspan="4">
              No valves or backflow devices are recorded yet.
            </td>
          </tr>
        )}
        {assets.map((asset) => (
          <tr>
            <td>{asset.label}</td>
            <td>{humanize(asset.type)}</td>
            <td>{controllerLabel(asset.controllerId)}</td>
            <td>
              <span class={`tag ${statusTagClass(asset.condition)}`}>
                {humanize(asset.condition)}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3>Trees</h3>
  <p>
    The tree layer, listed by the zone each tree stands in. Planting dates,
    bracing, and replant priority are on the
    {" "}<a href={withBase("/landscaping/trees")}>trees</a> page.
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Tree</th>
          <th>Species</th>
          <th>Zone</th>
          <th>Health</th>
        </tr>
      </thead>
      <tbody>
        {trees.length === 0 && (
          <tr>
            <td colspan="4">No trees recorded yet.</td>
          </tr>
        )}
        {trees.map((tree) => (
          <tr>
            <td>{tree.commonName}</td>
            <td>{tree.species}</td>
            <td>{zoneLabel(tree.zoneId)}</td>
            <td>
              <span class={`tag ${statusTagClass(tree.health)}`}>
                {humanize(tree.health)}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
