---
// One page per watering zone, generated at build time from zones.yaml.
// With the zone list empty this returns no paths and no pages are built,
// which is correct: there is nothing yet to link to from the map table.
import Base from "../../../layouts/Base.astro";
import { withBase } from "../../../lib/kit/base";
import { formatDate, formatMonth } from "../../../lib/kit/date";
import { statusTagClass } from "../../../lib/status-tag";
import {
  getZones,
  getControllers,
  getSchedule,
  getIssues,
  getTrees,
} from "../../../lib/data";
import type { IssueCategory } from "../../../lib/types";

export async function getStaticPaths() {
  // Seasons read spring, summer, fall, the order they happen in. Sorting
  // them alphabetically put fall first, which is the order nobody thinks
  // in. Same order as the watering times page.
  //
  // Declared inside this function rather than beside the other helpers
  // below on purpose: Astro extracts getStaticPaths into its own module,
  // so a const declared in the frontmatter is not in scope here and the
  // build dies with "SEASON_ORDER is not defined" the first time a zone
  // exists to render.
  const SEASON_ORDER: Record<string, number> = {
    spring: 0,
    summer: 1,
    fall: 2,
  };

  const controllers = getControllers();
  const schedule = getSchedule();
  const issues = getIssues();
  const trees = getTrees();

  return getZones().map((zone) => ({
    params: { id: zone.id },
    props: {
      zone,
      controller: controllers.find((c) => c.id === zone.controllerId) ?? null,
      schedule: schedule
        .filter((s) => s.zoneId === zone.id)
        .sort(
          (a, b) =>
            (SEASON_ORDER[a.season] ?? 9) - (SEASON_ORDER[b.season] ?? 9)
        ),
      openIssues: issues.filter(
        (i) => i.zoneId === zone.id && i.status !== "resolved"
      ),
      resolvedIssues: issues.filter(
        (i) => i.zoneId === zone.id && i.status === "resolved"
      ),
      zoneTrees: trees.filter((t) => t.zoneId === zone.id),
    },
  }));
}

const { zone, controller, schedule, openIssues, resolvedIssues, zoneTrees } =
  Astro.props;

// Same three helpers as the watering times page, and they have to stay
// the same: a zone reached from the map and the same zone read off the
// schedule table must not describe themselves differently.
const titleCase = (value: string): string =>
  value.charAt(0).toUpperCase() + value.slice(1);
const humanize = (value: string): string => titleCase(value.replace(/-/g, " "));

// Controller clocks are programmed in 24-hour time. The watering times
// page tells residents the site shows them in 12-hour, so this page owes
// them the same form.
function formatTime(value?: string): string {
  if (!value) return "—";
  const parts = /^(\d{1,2}):(\d{2})/.exec(value);
  if (!parts) return value;
  const hour24 = Number(parts[1]);
  const suffix = hour24 < 12 ? "am" : "pm";
  const hour12 = hour24 % 12 === 0 ? 12 : hour24 % 12;
  return `${hour12}:${parts[2]} ${suffix}`;
}

// The issue vocabulary is written out the same way the issue log writes
// it, so a category, a severity, and a status read identically whether a
// resident lands here or on the log.
const CATEGORY_LABELS: Record<IssueCategory, string> = {
  "dead-spot": "Dead spots",
  "schedule-timing": "Schedule and timing",
  "equipment-failure": "Equipment failure",
  "water-waste": "Water waste",
};

const SEVERITY_LABELS: Record<"high" | "medium" | "low", string> = {
  high: "High",
  medium: "Medium",
  low: "Low",
};

const STATUS_LABELS: Record<"open" | "monitoring" | "resolved", string> = {
  open: "Open",
  monitoring: "Monitoring",
  resolved: "Resolved",
};

// Planted dates arrive at day, month, or year precision. Same rule as the
// trees page: render the precision that was recorded rather than invent a
// day, and keep a full date from being flattened to a month.
function formatPlanted(value?: string): string {
  if (/^\d{4}-\d{2}$/.test(value ?? "")) return formatMonth(value);
  return formatDate(value, { empty: "—" });
}
---
<Base title={zone.label}>
  <nav class="subnav" aria-label="Landscaping sections">
    {/* No item is current here. A zone detail page is reached from the
        map but is not the map, and marking Map as current made every
        zone page announce itself as the map to a screen reader. */}
    <a href={withBase("/landscaping")}>Map</a>
    <a href={withBase("/landscaping/watering")}>Watering times</a>
    <a href={withBase("/landscaping/trees")}>Trees</a>
    <a href={withBase("/landscaping/issues")}>Issues</a>
    <a href={withBase("/landscaping/water")}>Water use</a>
    <a href={withBase("/landscaping/report")}>Report a problem</a>
  </nav>

  <div class="eyebrow">Landscaping zone</div>
  <h2>{zone.label}</h2>
  <p>
    {zone.area}. Quote this zone number when you report a problem here, so the
    contractor knows which valve to open. <a href={withBase("/landscaping")}>Back to the map</a>.
  </p>

  <div class="card">
    <h3 style="margin-top:0">Zone detail</h3>
    <div class="table-wrap">
      <table>
        <tbody>
          <tr>
            <th scope="row">Controller</th>
            <td>{controller ? `${controller.label}: ${controller.areaServed}` : "—"}</td>
          </tr>
          <tr>
            <th scope="row">Area</th>
            <td>{zone.area}</td>
          </tr>
          <tr>
            <th scope="row">Head type</th>
            <td>{humanize(zone.headType)}</td>
          </tr>
          <tr>
            <th scope="row">Planting</th>
            <td>{humanize(zone.plantType)}</td>
          </tr>
          <tr>
            <th scope="row">Sun exposure</th>
            <td>{zone.sunExposure ? humanize(zone.sunExposure) : "—"}</td>
          </tr>
          <tr>
            <th scope="row">Condition</th>
            <td>
              <span class={`tag ${statusTagClass(zone.condition)}`}>
                {humanize(zone.condition)}
              </span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    {zone.notes && <p>{zone.notes}</p>}
  </div>

  <h3>Watering times</h3>
  {schedule.length === 0 ? (
    <p class="notice">
      No programmed times are recorded for this zone yet. They come off the
      controller itself rather than from an estimate, so the row stays empty
      until someone reads the clock.
    </p>
  ) : (
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Season</th>
            <th>Days</th>
            <th>Start</th>
            <th>Runtime</th>
            <th>Effective</th>
          </tr>
        </thead>
        <tbody>
          {schedule.map((entry) => (
            <tr>
              <td>{titleCase(entry.season)}</td>
              <td>{entry.days.length > 0 ? entry.days.join(", ") : "—"}</td>
              <td>{formatTime(entry.startTime)}</td>
              <td>{entry.runtimeMinutes} min</td>
              <td>{formatDate(entry.effectiveDate, { empty: "—" })}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <h3>Open issues</h3>
  {openIssues.length === 0 ? (
    <p>Nothing is currently open against this zone.</p>
  ) : (
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Opened</th>
            <th>Category</th>
            <th>Severity</th>
            <th>Status</th>
            <th>Summary</th>
          </tr>
        </thead>
        <tbody>
          {openIssues.map((issue) => (
            <tr>
              <td>{formatDate(issue.openedDate, { empty: "—" })}</td>
              <td>{CATEGORY_LABELS[issue.category] ?? humanize(issue.category)}</td>
              <td>
                <span class={`tag ${statusTagClass(issue.severity)}`}>
                  {SEVERITY_LABELS[issue.severity]}
                </span>
              </td>
              <td>
                <span class={`tag ${statusTagClass(issue.status)}`}>
                  {STATUS_LABELS[issue.status]}
                </span>
              </td>
              <td>{issue.summary}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {resolvedIssues.length > 0 && (
    <>
      <h3>Resolved</h3>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Opened</th>
              <th>Resolved</th>
              <th>Category</th>
              <th>Summary</th>
            </tr>
          </thead>
          <tbody>
            {resolvedIssues.map((issue) => (
              <tr>
                <td>{formatDate(issue.openedDate, { empty: "—" })}</td>
                <td>{formatDate(issue.resolvedDate, { empty: "—" })}</td>
                <td>{CATEGORY_LABELS[issue.category] ?? humanize(issue.category)}</td>
                <td>{issue.summary}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <h3>Trees in this zone</h3>
  {zoneTrees.length === 0 ? (
    <p>No trees are recorded in this zone.</p>
  ) : (
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Tree</th>
            <th>Species</th>
            <th>Planted</th>
            <th>Health</th>
            <th>Braced</th>
            <th>Replant priority</th>
          </tr>
        </thead>
        <tbody>
          {zoneTrees.map((tree) => (
            <tr>
              <td>{tree.commonName}</td>
              <td>{tree.species}</td>
              <td>{formatPlanted(tree.planted)}</td>
              <td>
                <span class={`tag ${statusTagClass(tree.health)}`}>
                  {humanize(tree.health)}
                </span>
              </td>
              <td>{tree.braced ? "Yes" : "No"}</td>
              <td>{tree.replantPriority ?? "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</Base>
