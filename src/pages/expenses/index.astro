---
import Base from "../../layouts/Base.astro";
import { getExpenses } from "../../lib/data";
import { statusTagClass } from "../../lib/status-tag";

const expenses = getExpenses().slice().sort((a, b) => b.date.localeCompare(a.date));
---
<Base title="Expenses">
  <div class="eyebrow">Expenses</div>
  <h2>Expenses</h2>
  <p>Public category/status metadata only. Dollar amounts and vendor names are kept in the private, not-publicly-committed file.</p>
  {expenses.length > 0 ? (
    <table>
      <thead><tr><th>Date</th><th>Category</th><th>Status</th><th>Note</th></tr></thead>
      <tbody>
        {expenses.map((e) => (
          <tr>
            <td>{e.date}</td>
            <td>{e.category}</td>
            <td><span class={`tag ${statusTagClass(e.status)}`}>{e.status}</span></td>
            <td>{e.note ?? "—"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : <p class="notice">No expenses on file yet.</p>}
</Base>
