---
import Base from "../layouts/Base.astro";
import { getGovernance, getPolicies, getNotices } from "../lib/data";
import { statusTagClass } from "../lib/status-tag";

const gov = getGovernance();
const policies = getPolicies().slice().sort((a, b) => a.phase - b.phase);
const notices = getNotices();
---
<Base title="Governance & Policies">
  <div class="eyebrow">Governance</div>
  <h2>Governance & Policies</h2>

  {gov && (
    <div class="card">
      <h3 style="margin-top:0">Entity status</h3>
      <p><strong>{gov.entityName}</strong>: {gov.entityType}</p>
      <p>{gov.entityStatusNotes}</p>
      {gov.openComplianceItems.length > 0 && (
        <>
          <p><strong>Open compliance items:</strong></p>
          <ul>
            {gov.openComplianceItems.map((item) => <li>{item}</li>)}
          </ul>
        </>
      )}
    </div>
  )}

  {gov && (
    <div class="card">
      <h3 style="margin-top:0">Board officers</h3>
      <table>
        <thead><tr><th>Name</th><th>Role</th><th>Since</th><th>Prior role</th></tr></thead>
        <tbody>
          {gov.officers.map((o) => (
            <tr>
              <td>{o.name}</td>
              <td>{o.role}</td>
              <td>{o.since}</td>
              <td>{o.priorRole ?? "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p>{gov.boardTermNotes}</p>
    </div>
  )}

  <h3>Enforcement policies</h3>
  <p>Phased CC&Rs enforcement notices, draft until sent to homeowners.</p>
  {policies.map((p) => (
    <div class="card">
      <h4 style="margin-top:0">Phase {p.phase}: {p.title} <span class={`tag ${statusTagClass(p.status)}`}>{p.status}</span></h4>
      <p><strong>CC&Rs basis:</strong></p>
      <ul>
        {p.ccrBasis.map((b) => <li>{b}</li>)}
      </ul>
      <p><strong>Rules:</strong></p>
      <ul>
        {p.rules.map((r) => <li>{r}</li>)}
      </ul>
      <p><strong>Enforcement:</strong> {p.enforcement}</p>
      {p.history && <p><strong>History:</strong> {p.history}</p>}
    </div>
  ))}

  {notices.length > 0 && (
    <>
      <h3>Resident notices</h3>
      {notices.map((n) => (
        <div class="card">
          <h4 style="margin-top:0">{n.title} <span class={`tag ${statusTagClass(n.status)}`}>{n.status}</span></h4>
          <p>{n.text}</p>
        </div>
      ))}
    </>
  )}
</Base>
