---
import Base from "../../layouts/Base.astro";
import { getBudgets } from "../../lib/data";

const budgets = getBudgets().slice().sort((a, b) => b.fiscalYear.localeCompare(a.fiscalYear));
---
<Base title="Budget">
  <h1>Budget</h1>
  <p>Category names only. Budgeted/actual dollar figures are kept in the private, not-publicly-committed file.</p>
  {budgets.length > 0 ? budgets.map((b) => (
    <div class="card">
      <h2 style="margin-top:0">{b.fiscalYear}</h2>
      <ul>
        {b.categories.map((cat) => <li>{cat}</li>)}
      </ul>
      {b.notes && <p>{b.notes}</p>}
    </div>
  )) : <p class="notice">No budget on file yet.</p>}
</Base>
