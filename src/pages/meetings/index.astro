---
import Base from "../../layouts/Base.astro";
import { getMeetings } from "../../lib/data";
import { withBase } from "../../lib/base";
import { statusTagClass } from "../../lib/status-tag";

const meetings = getMeetings().slice().sort((a, b) => b.date.localeCompare(a.date));
---
<Base title="Meetings">
  <div class="eyebrow">Meetings</div>
  <h2>Meetings</h2>
  <p>Monthly board meetings, plus an annual all-homeowner meeting (held 2026-03-31 this year, not the traditional April).</p>
  <table>
    <thead><tr><th>Date</th><th>Type</th><th>Status</th><th>Minutes</th></tr></thead>
    <tbody>
      {meetings.map((m) => (
        <tr>
          <td><a href={withBase(`/meetings/${m.id}`)}>{m.date}</a></td>
          <td>{m.type === "annual-homeowners" ? "Annual (all homeowners)" : "Monthly board"}</td>
          <td><span class={`tag ${statusTagClass(m.status)}`}>{m.status}</span></td>
          <td>{m.hasMinutes ? "On file (private)" : "—"}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>
