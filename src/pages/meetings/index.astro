---
import Base from "../../layouts/Base.astro";
import { getMeetings } from "../../lib/data";
import { withBase } from "../../lib/base";

const meetings = getMeetings().slice().sort((a, b) => b.date.localeCompare(a.date));
---
<Base title="Meetings">
  <h1>Meetings</h1>
  <p>Monthly board meetings, plus the annual all-homeowner meeting each April.</p>
  <table>
    <thead><tr><th>Date</th><th>Type</th><th>Status</th><th>Minutes</th></tr></thead>
    <tbody>
      {meetings.map((m) => (
        <tr>
          <td><a href={withBase(`/meetings/${m.id}`)}>{m.date}</a></td>
          <td>{m.type === "annual-homeowners" ? "Annual (all homeowners)" : "Monthly board"}</td>
          <td><span class={`tag tag-${m.status}`}>{m.status}</span></td>
          <td>{m.hasMinutes ? "On file (private)" : "—"}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>
